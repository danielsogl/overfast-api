# Container settings
APP_VOLUME_PATH=
APP_PORT=80

# Application settings
APP_BASE_URL=https://api.mercy-stats.app
LOG_LEVEL=info
STATUS_PAGE_URL=
PROFILER=
NEW_ROUTE_PATH=

# Rate limiting
# Comma-separated CIDRs of upstream proxies allowed to set X-Forwarded-For
# (e.g. "10.0.0.0/8,192.168.0.0/16"). Leave empty when nginx is exposed
# directly, otherwise clients can spoof the header and bypass rate limiting.
# List only the proxies you actually run: 0.0.0.0/0 trusts every client and
# restores the bypass.
TRUSTED_PROXY_CIDRS=
RETRY_AFTER_HEADER=Retry-After
RATE_LIMIT_PER_SECOND_PER_IP=30
RATE_LIMIT_PER_IP_BURST=5
MAX_CONNECTIONS_PER_IP=10

# Adaptive throttling (TCP Slow Start + AIMD for Blizzard requests)
THROTTLE_ENABLED=true
THROTTLE_START_DELAY=2.0
THROTTLE_MIN_DELAY=0.1
THROTTLE_MAX_DELAY=30.0
THROTTLE_SLOW_START_N_SUCCESSES=10
THROTTLE_AIMD_N_SUCCESSES=20
THROTTLE_AIMD_DELTA=0.05
THROTTLE_PENALTY_DELAY=10.0
THROTTLE_PENALTY_DURATION=60

# Background worker
WORKER_MAX_CONCURRENT_JOBS=10
WORKER_JOB_TIMEOUT=300

# Nginx tuning
# Number of worker processes (0 = auto-detect CPU cores, or set explicit number like 4, 8, etc.)
NGINX_WORKER_PROCESSES=0
NGINX_WORKER_CONNECTIONS=1024
NGINX_MULTI_ACCEPT=true

# Valkey
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_MEMORY_LIMIT=1gb

# Persistent Storage (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=overfast
POSTGRES_USER=overfast
# REQUIRED: set a strong password, do not leave empty
POSTGRES_PASSWORD=
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10

# Unknown players cache system
UNKNOWN_PLAYERS_CACHE_ENABLED=true
UNKNOWN_PLAYER_COOLDOWN_KEY_PREFIX=unknown-player:cooldown
UNKNOWN_PLAYER_INITIAL_RETRY=600
UNKNOWN_PLAYER_RETRY_MULTIPLIER=3
UNKNOWN_PLAYER_MAX_RETRY=21600
UNKNOWN_PLAYER_MIN_RETENTION_COUNT=5

# Cache configuration
CACHE_TTL_HEADER=X-Cache-TTL
CONDITIONAL_GET_HEADER=X-Conditional-Get
HEROES_PATH_CACHE_TIMEOUT=86400
HERO_PATH_CACHE_TIMEOUT=86400
CSV_CACHE_TIMEOUT=86400
CAREER_PATH_CACHE_TIMEOUT=600
SEARCH_ACCOUNT_PATH_CACHE_TIMEOUT=600
HERO_STATS_CACHE_TIMEOUT=3600
# Patch notes are news: a hotfix lands the day it is published, so 1h rather
# than the 24h used for the other static data.
PATCH_NOTES_CACHE_TIMEOUT=3600
PLAYER_PROFILE_MAX_AGE=604800
# Maximum age of player snapshots in seconds (0 = keep forever)
PLAYER_SNAPSHOT_MAX_AGE=31536000
# Maximum age of hero stats snapshots in seconds (0 = keep forever).
# Three rows a day, and the whole value of the series is being long.
HERO_STATS_SNAPSHOT_MAX_AGE=63072000

# SWR staleness thresholds
HEROES_STALENESS_THRESHOLD=86400  # 24 hours
MAPS_STALENESS_THRESHOLD=86400
GAMEMODES_STALENESS_THRESHOLD=86400
ROLES_STALENESS_THRESHOLD=86400
PATCH_NOTES_STALENESS_THRESHOLD=3600  # 1 hour, same reasoning as the TTL above
PLAYER_STALENESS_THRESHOLD=3600  # 1 hour

# Age beyond which a stored player profile is no longer served and the
# request waits for Blizzard. Everything below is answered from storage at
# once with a background refresh enqueued. The ceiling guards one failure
# mode: with the worker down, refreshes never run, and without it every
# profile would keep serving indefinitely old data while looking healthy.
PLAYER_MAX_SERVE_AGE=86400  # 24 hours
STALE_CACHE_TIMEOUT=60

# Seconds GET /players/summaries waits for its fan-out before answering with
# whatever finished and marking the rest pending. Must stay well under nginx's
# proxy_read_timeout (30s), or the proxy drops the connection before the
# degraded answer goes out.
BATCH_SUMMARIES_TIMEOUT=10.0

# Optional. Where scripts/vps/healthcheck.sh posts outage and recovery
# messages. Empty means log-only, which is the default behaviour.
# Any URL accepting a JSON POST works; Slack and Discord webhooks are
# read directly ("text" / "content").
ALERT_WEBHOOK_URL=
